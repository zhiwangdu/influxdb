{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influxdb.local/docs/sdd/spec.schema.json",
  "title": "InfluxDB SDD Spec",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "context",
    "scope",
    "contracts",
    "implementation_plan",
    "validation",
    "release_and_rollback"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^SPEC-[0-9]{4}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 5},
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "implemented", "verified", "released"]
    },
    "owner": {"type": "string"},
    "reviewers": {"type": "array", "items": {"type": "string"}},
    "context": {
      "type": "object",
      "required": ["goals"],
      "properties": {
        "background": {"type": "string"},
        "goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contracts": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "api": {"type": "array", "items": {"type": "object"}},
        "data": {"type": "array", "items": {"type": "object"}},
        "config": {"type": "array", "items": {"type": "object"}}
      }
    },
    "implementation_plan": {
      "type": "object",
      "required": ["milestones"],
      "properties": {
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "tasks"],
            "properties": {
              "name": {"type": "string"},
              "tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["unit_tests", "integration_tests"],
      "properties": {
        "unit_tests": {"type": "array", "items": {"type": "string"}},
        "integration_tests": {"type": "array", "items": {"type": "string"}},
        "performance_tests": {"type": "array", "items": {"type": "string"}},
        "regression_tests": {"type": "array", "items": {"type": "string"}},
        "manual_checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "release_and_rollback": {
      "type": "object",
      "required": ["rollout", "rollback"],
      "properties": {
        "rollout": {"type": "string"},
        "rollback": {"type": "string"},
        "data_recovery": {"type": "string"}
      }
    }
  }
}
